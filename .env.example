# Copy to .env and fill in real values. .env is gitignored; this template is not.
# On real EKS we would NOT use access keys: pods get AWS permissions via
# IAM Roles for Service Accounts (IRSA) / EKS Pod Identity.

AWS_REGION=us-east-2
AWS_DEFAULT_REGION=us-east-2
AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me
MWP_S3_BUCKET=replace-me
MWP_SECRET_NAME=mwp/vendor-api-key

# Airflow REST API (used by FastAPI in M4)
AIRFLOW_API_URL=http://localhost:8080
AIRFLOW_USERNAME=airflow
AIRFLOW_PASSWORD=airflow
